# ---- Required ----
# API key for the Claude model provider
ANTHROPIC_API_KEY=

# ---- Strongly recommended in production ----
# Shared secret your gateway sends in the X-API-Key header
RAG_API_KEY=
# Enables POST /ingest/sync (send this value in X-Admin-Key). Leave empty to disable.
RAG_ADMIN_KEY=

# ---- Optional (defaults shown) ----
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_REWRITE_MODEL=claude-haiku-4-5-20251001
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANK_ENABLED=true
# RERANK_MIN_SCORE=-4.0
# CANDIDATES_K=30
# FINAL_K=6
# CHUNK_TARGET_TOKENS=450
# CHUNK_OVERLAP_TOKENS=50
# AUTO_INGEST=true
# DOCS_DIR=docs
# DATA_DIR=data
